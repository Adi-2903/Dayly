{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dayly",
  "version": "0.4.0",
  "identifier": "com.adityajain.dayly",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dayly",
        "width": 200,
        "height": 200,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "Aditya Jain",
    "copyright": "Copyright \u00a9 2026 Aditya Jain",
    "shortDescription": "Dayly - desktop countdown widget",
    "longDescription": "Dayly is a lightweight desktop countdown widget with themes, shapes and a flip-to-clock side."
  }
}